{
  "compilerOptions": {
    // Laufzeit-Ziel & Module
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    // Ordner
    "rootDir": "src",
    "outDir": "dist",

    // Node-Typen
    "lib": ["ES2020"],
    "types": ["node"],

    // Qualität & Interop
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Debug
    "sourceMap": true
  },
  "include": ["src"]
}

